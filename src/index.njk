<script>
  // Experience section scroll (guarded)
  (function() {
    // match '#experience' or '/index#experience' etc.
    const experienceLink = document.querySelector('a[href*="#experience"]');

    // Only attach handler if the element exists
    if (!experienceLink) return;

    experienceLink.addEventListener('click', (e) => {
      e.preventDefault();
      const targetElement = document.getElementById('experience');
      if (targetElement) {
        window.scrollTo({
          top: targetElement.offsetTop,
          behavior: 'smooth'
        });
      }
    });
  })();

    // Back to top button visibility
    window.addEventListener('scroll', () => {
        if (window.pageYOffset > 300) {
            document.querySelector('.back-to-top').classList.add('visible');
        } else {
            document.querySelector('.back-to-top').classList.remove('visible');
        }
    });

    document.querySelector('.back-to-top').addEventListener('click', () => {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });

    // ASCII portrait shimmer — randomly swap a few characters per tick with
    // similar-density glyphs to create a flickering "scanning" effect.
    (function() {
      const pre = document.getElementById('ascii-portrait');
      if (!pre) return;
      const original = pre.textContent;
      const chars = original.split('');
      // Density buckets so swaps preserve overall shape.
      const buckets = [
        ' .,`\'',
        ':;~"',
        '*+=-/',
        '(){}[]',
        '#%&$',
        '@8B'
      ];
      const bucketOf = (c) => buckets.find(b => b.includes(c)) || '';

      // Index of non-blank glyph positions.
      const live = [];
      for (let i = 0; i < chars.length; i++) {
        if (chars[i] !== ' ' && chars[i] !== '\n') live.push(i);
      }
      if (!live.length) return;

      let working = chars.slice();
      const swapsPerTick = Math.max(20, Math.floor(live.length * 0.05));

      function tick() {
        for (let n = 0; n < swapsPerTick; n++) {
          const idx = live[Math.floor(Math.random() * live.length)];
          const orig = chars[idx];
          const bucket = bucketOf(orig);
          if (!bucket) continue;
          // 88% noise, 12% restore — silhouette still readable but much more active.
          if (Math.random() < 0.88) {
            working[idx] = bucket[Math.floor(Math.random() * bucket.length)];
          } else {
            working[idx] = orig;
          }
        }
        pre.textContent = working.join('');
      }

      // Pause when off-screen to save cycles.
      let timer = null;
      function start() { if (!timer) timer = setInterval(tick, 50); }
      function stop()  { if (timer) { clearInterval(timer); timer = null; } }

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => e.isIntersecting ? start() : stop());
        });
        io.observe(pre);
      } else {
        start();
      }
    })();
</script>

